# ==========================================================================
# VARIÁVEIS DE AMBIENTE
# Copie para ".env" e preencha. NUNCA versione o .env.
# Nenhum destes valores chega ao navegador — são lidos só pelo servidor.
# ==========================================================================

# --- Administrador do painel (/admin) ---
ADMIN_EMAIL='voce@seudominio.com'

# Gere o hash com:  npm run admin:hash -- "sua-senha-forte"
# e cole o resultado aqui. Prefira SEMPRE o hash em produção.
ADMIN_PASSWORD_HASH=''

# Alternativa só para o primeiro boot em desenvolvimento (vira hash sozinho).
# Deixe vazio se usar ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=''

# --- Sessão ---
# Obrigatório em produção. Gere com: openssl rand -hex 32
SESSION_SECRET=''
SESSION_TTL_HOURS='12'

# --- Servidor ---
PORT='3001'

# NÃO defina NODE_ENV aqui: o Vite também lê este arquivo e um NODE_ENV de
# desenvolvimento faria o build de produção sair com a versão de debug do
# React. Em produção use "npm start", que já define NODE_ENV=production.

# Onde ficam o banco (app.db) e as imagens enviadas (uploads/).
# Em produção aponte para um disco persistente.
DATA_DIR='./data'

# Limite por imagem enviada (bytes). Padrão: 8 MB.
MAX_UPLOAD_BYTES='8388608'
