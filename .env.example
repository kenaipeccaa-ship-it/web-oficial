# ==========================================================================
# VARIÁVEIS DE AMBIENTE
# Copie para ".env" (desenvolvimento) ou cadastre no painel da Vercel
# (produção). NUNCA versione o .env. Nenhum destes valores chega ao
# navegador — são lidos só pelo servidor.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) ADMINISTRADOR DO PAINEL (/admin) — obrigatório nos dois ambientes
# --------------------------------------------------------------------------
ADMIN_EMAIL='voce@seudominio.com'

# Gere o hash com:  npm run admin:hash -- "sua-senha-forte"
# e cole o resultado aqui. Prefira SEMPRE o hash — em produção, use só ele.
ADMIN_PASSWORD_HASH=''

# Alternativa só para o primeiro boot em desenvolvimento (vira hash sozinho).
# Deixe vazio se usar ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=''

# --------------------------------------------------------------------------
# 2) SESSÃO — obrigatório em produção
# --------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
SESSION_SECRET=''
SESSION_TTL_HOURS='12'

# --------------------------------------------------------------------------
# 3) BANCO DE DADOS
# --------------------------------------------------------------------------
# DESENVOLVIMENTO: deixe as duas vazias. O projeto usa um arquivo SQLite local
# em DATA_DIR/app.db, com o MESMO driver (libSQL) usado em produção.
#
# PRODUÇÃO (Vercel): obrigatórias. Crie um banco no Turso (https://turso.tech),
# rode `turso db show --url <nome>` e `turso db tokens create <nome>`.
TURSO_DATABASE_URL=''
TURSO_AUTH_TOKEN=''

# --------------------------------------------------------------------------
# 4) IMAGENS
# --------------------------------------------------------------------------
# DESENVOLVIMENTO: deixe vazia. As imagens vão para DATA_DIR/uploads.
#
# PRODUÇÃO (Vercel): obrigatória. Crie um store em Storage → Blob no painel
# da Vercel; ao conectar ao projeto, a Vercel injeta esta variável sozinha.
BLOB_READ_WRITE_TOKEN=''

# --------------------------------------------------------------------------
# 5) SERVIDOR — só no desenvolvimento local
# --------------------------------------------------------------------------
PORT='3001'

# Onde ficam o banco em arquivo e as imagens enviadas, localmente.
DATA_DIR='./data'

# Limite por imagem enviada (bytes). Padrão: 8 MB.
MAX_UPLOAD_BYTES='8388608'

# NÃO defina NODE_ENV aqui: o Vite também lê este arquivo e um NODE_ENV de
# desenvolvimento faria o build de produção sair com a versão de debug do
# React. O "npm start" já define NODE_ENV=production.
